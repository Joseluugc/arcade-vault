# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repositorio.

# Envío del formulario de contacto de /acerca con Resend (SPEC 06).
# Clave de API: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Destinatario de los mensajes. Sin dominio verificado en Resend, debe ser el correo de tu cuenta.
CONTACT_TO_EMAIL=tu-correo@ejemplo.com
# Remitente. onboarding@resend.dev funciona sin dominio verificado.
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>

# Conexión con Supabase (SPEC 07). Valores en el panel de Supabase: Project Settings → API.
# URL del proyecto, p. ej. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_…). Es pública por diseño. No uses la clave secreta / service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
